# Copia este archivo a .env y ajusta los valores reales. Nunca subas .env a git.
# docker-compose.yml lee este mismo archivo automáticamente.

NODE_ENV=production

# Contraseña de la base de datos dentro de Docker (el contenedor "esturion-db")
DB_PASSWORD=CAMBIA_ESTA_CLAVE

# Si corres SIN Docker (Node + PostgreSQL instalados directo en el VPS), usa esta variable en vez de DB_PASSWORD:
DATABASE_URL=postgresql://esturion:CAMBIA_ESTA_CLAVE@localhost:5432/esturion_db

# JWT — genera un secreto largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=7d

# Dominio del frontend (para CORS)
CLIENT_ORIGIN=https://tu-dominio.com
